# ─── Gemini API ────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# AI stil yorumlarinin dili: tr | en
ANALYSIS_LOCALE=tr

# ─── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://outfit:outfit@localhost:5432/outfit_studio

# ─── File storage ──────────────────────────────────────────────
# local = ./storage klasoru (sadece gelistirme) | s3 = S3/R2 uyumlu depolama
STORAGE_DRIVER=local
STORAGE_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_PUBLIC_URL=

# ─── Misc ──────────────────────────────────────────────────────
# Sadece lokalde rate limit kapatmak icin "1" yap
RATE_LIMIT_DISABLED=
