# ─── Gemini API ────────────────────────────────────────────────────────────────
# Server-side only. Never exposed to the frontend.
GEMINI_API_KEY=

# Model names are configurable so upgrades never require code changes.
# Verified against the Gemini API docs (Interactions API, Sept 2026):
#   Text / structured output ... gemini-3.8-flash
#   Vision (image analysis) .... gemini-3.8-flash (multimodal)
#   Image generation ........... gemini-3.1-flash-image  (Nano Banana 2 — supports
#                                up to 10 high-fidelity reference images)
# Alternatives: gemini-3-pro-image (higher quality, max 6 reference images),
#               gemini-3.1-flash-lite-image (cheapest, NOT suited to multi-reference).
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Language of AI style commentary shown to users: tr | en
ANALYSIS_LOCALE=tr

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://outfit:outfit@localhost:5432/outfit_studio

# ─── File storage ─────────────────────────────────────────────────────────────
# local = ./storage on disk, served through /api/files (default, zero config)
# s3    = any S3-compatible storage (AWS S3, Cloudflare R2, MinIO, ...)
STORAGE_DRIVER=local
STORAGE_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=auto
# Optional: public base URL of the bucket. When set, images are served directly
# from storage instead of being proxied through /api/files.
STORAGE_PUBLIC_URL=

# ─── Misc ─────────────────────────────────────────────────────────────────────
# Set to "1" only in local development to disable per-IP rate limits.
RATE_LIMIT_DISABLED=
